{
  "name": "self-healing-distributed-cache",
  "version": "1.0.0",
  "description": "A self-healing distributed cache cluster built with TypeScript and Node.js.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/scripts/startCluster.js",
    "dev": "ts-node src/scripts/startCluster.ts",
    "cluster:start": "ts-node src/scripts/startCluster.ts",
    "test:resilience": "ts-node src/tests/loadTest.ts",
    "seed:stress": "ts-node src/scripts/createStressKeys.ts",
    "load:simulate": "ts-node src/scripts/simulateAutoscaleLoad.ts",
    "test:autoscale": "ts-node src/tests/testAutoscale.ts",
    "tunnel": "npx localtunnel --port 8000"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2"
  }
}
